#
# Script mode (cmake -P): write a C++ source that holds the bytes of INPUT as
# `extern unsigned char const SYMBOL[]` and their count as `extern unsigned int
# const SYMBOL_len`, at OUTPUT.
#
# The bytes are spelled out in the source rather than pulled in with C23 #embed
# because a compiler cache keys a compilation on the preprocessed source and the
# files it names, and #embed names its file nowhere the cache looks: a changed
# INPUT behind an unchanged .cpp was served from the cache with the old bytes. A
# generated source changes with its input, so the cache sees it.
#
# cmake -DINPUT=<file> -DOUTPUT=<file.cpp> -DSYMBOL=<name> -P embed_file.cmake

foreach(_var INPUT OUTPUT SYMBOL)
  if(NOT DEFINED ${_var})
    message(FATAL_ERROR "embed_file.cmake: ${_var} is not set")
  endif()
endforeach()

file(READ "${INPUT}" _hex HEX)
string(LENGTH "${_hex}" _hex_length)
math(EXPR _bytes "${_hex_length} / 2")
# Twelve bytes a line keeps the file readable in a diff without making it long.
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _array "${_hex}")
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){12})" "\\1\n    " _array
                     "${_array}")

file(
  WRITE "${OUTPUT}"
  "// Generated by cmake/embed_file.cmake from ${INPUT}; do not edit.
// extern is required: in C++, const at namespace scope implies internal linkage.
extern unsigned char const ${SYMBOL}[] = {
    ${_array}
};
extern unsigned int const ${SYMBOL}_len = ${_bytes}U;
")
