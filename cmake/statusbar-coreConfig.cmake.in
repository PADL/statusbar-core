#
# Generated CMake package config for statusbar-core.
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# statusbar-net publicly exposes libbpf / libxdp headers and link
# requirements via net_linux_xdp.hpp on Linux. If the build that produced
# this package was configured with AF_XDP support (HAVE_XDP), downstream
# consumers must be able to resolve libbpf/libxdp the same way.
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
  find_dependency(PkgConfig QUIET)
  if(PkgConfig_FOUND)
    pkg_check_modules(LIBBPF QUIET libbpf)
    pkg_check_modules(LIBXDP QUIET libxdp)
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/statusbar-coreTargets.cmake")

# statusbar-core is the single source of truth for the shared build
# machinery: module.cmake (statusbar_add_module and the package boilerplate
# helpers, which itself pulls in the sanitizer/coverage/fuzzing/clang-tidy
# options) ships beside this config, both installed and in core's build
# tree. Including it here means a dependent package gets everything from
# its ordinary find_package(statusbar-core) with no cmake/ copies of its
# own. Guarded: under the umbrella aggregate the top-level project already
# included the same files at a wider scope.
if(NOT COMMAND statusbar_add_module)
  include("${CMAKE_CURRENT_LIST_DIR}/module.cmake")
endif()

check_required_components(statusbar-core)
